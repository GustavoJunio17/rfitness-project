# =====================================================================
# Supabase — Project Settings > API / Database
# =====================================================================
# Pooled connection (PgBouncer, porta 6543) — usada pela app em runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexão direta (porta 5432) — usada só por `prisma migrate`.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
# Segredo de servidor — nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_STORAGE_BUCKET="rfitness-uploads"

# =====================================================================
# Estoque
# =====================================================================
STOCK_EXPIRING_SOON_DAYS=7
STOCK_STALE_AFTER_DAYS=60

# =====================================================================
# Cron (Vercel Cron Jobs) — protege /api/cron/*
# =====================================================================
CRON_SECRET="change-me-cron-secret"

# =====================================================================
# WhatsApp (Evolution API self-hosted)
# =====================================================================
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY=""
WHATSAPP_FOLLOWUP_AFTER_DAYS=3

# =====================================================================
# LLM (Anthropic)
# =====================================================================
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"
# "true" testa o fluxo do WhatsApp sem chamar a Anthropic (sem custo).
ANTHROPIC_MOCK_MODE="false"

# =====================================================================
# Pagamentos (Mercado Pago) — Fase 8
# =====================================================================
MERCADO_PAGO_ACCESS_TOKEN=""
