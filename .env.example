# ---- Banco de dados ----
DATABASE_URL="postgresql://rfitness:rfitness@localhost:5432/rfitness?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- API (NestJS) ----
API_PORT=3001
CORS_ORIGIN="http://localhost:3000"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ---- Storage (Supabase Storage / S3-compatible) — usado a partir da Fase 2 ----
# STORAGE_DRIVER=local usa disco local em apps/api/uploads (padrão em dev, zero config).
# STORAGE_DRIVER=supabase exige as credenciais abaixo.
STORAGE_DRIVER="local"
LOCAL_UPLOADS_DIR="uploads"
LOCAL_PUBLIC_BASE_URL="http://localhost:3001/uploads"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="rfitness-uploads"

# ---- Estoque — usado a partir da Fase 2 ----
STOCK_EXPIRING_SOON_DAYS=7
STOCK_STALE_AFTER_DAYS=60

# ---- WhatsApp (Evolution API) — usado a partir da Fase 6 ----
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY=""

# ---- LLM (Claude / Anthropic) — usado a partir da Fase 6 ----
ANTHROPIC_API_KEY=""
# "true" para testar o fluxo do WhatsApp sem chamar a Anthropic de verdade (sem custo)
ANTHROPIC_MOCK_MODE="false"

# ---- Pagamentos (Mercado Pago) — usado a partir da Fase 4/8 ----
MERCADO_PAGO_ACCESS_TOKEN=""
